 <office:body>
  <office:text>
   <text:h text:outline-level="1">Engagement Letter</text:h>
   <text:p>March 3, 2025</text:p>
   <text:p>Attention: Lena Müller, Controller</text:p>
   <text:p>This letter confirms the engagement between Harbor Lantern Accounting LLP and Juniper Ridge Holdings Inc. for the audit of the 2024 financial statements.</text:p>
   <text:p>Signed for Harbor Lantern Accounting LLP by Mara Quill, Partner.</text:p>
  </office:text>
 </office:body>
</office:document>
