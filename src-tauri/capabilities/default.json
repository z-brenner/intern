{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for Intern.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-progress-bar",
    "core:window:allow-request-user-attention",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://z-brenner.github.io/intern/*" },
        { "url": "https://teamcontoso.sharepoint.com/sites/InternTestSite" },
        { "url": "https://www.microsoft.com/microsoft-365/onedrive/download" }
      ]
    },
    "updater:default"
  ]
}
